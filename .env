# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic
OPENAI_API_KEY=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
MODEL_NAME=gpt-4-turbo-preview  # or claude-3-opus-20240229
TEMPERATURE=0.2
MAX_TOKENS=4000
MODEL_TYPE=gemma3_text

# Vector DB Configuration
VECTOR_DB_TYPE=faiss  # Options: faiss, chroma
VECTOR_DB_PATH=./data/vector_db
EMBEDDING_MODEL=multi-qa-MiniLM-L6-cos-v1
EMBEDDING_DIM=384
VECTORIZED_FILES_TRACKER=./data/.vectorized_files.json

# Input Paths
INPUT_HTML_PATH=./input/page.html
INPUT_SCENARIOS_PATH=./input/scenarios.txt
EXISTING_FEATURE_PATH=./input/existing/old.feature
EXISTING_STEPDEF_PATH=./input/existing/StepDefsOld.java
EXISTING_PAGEOBJ_PATH=./input/existing/PageObjectsOld.java

# Output Configuration
OUTPUT_DIR=./output
OUTPUT_FEATURE_FILE=NewTests.feature
OUTPUT_STEPDEF_FILE=NewStepDefinitions.java
OUTPUT_PAGEOBJ_FILE=NewPageObjects.java

# Agent Configuration
MAX_RETRIES=3
ORCHESTRATOR_MAX_ITERATIONS=3
VALIDATION_STRICT_MODE=true

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/app.log

# Performance
BATCH_SIZE=10
TOP_K_RETRIEVAL=5